        {
          "name": "View Order Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "const schema = {\r",
                  "  \"type\": \"object\",\r",
                  "  \"properties\": {\r",
                  "    \"data\": {\r",
                  "      \"type\": \"object\",\r",
                  "      \"properties\": {\r",
                  "        \"_id\": {\r",
                  "          \"type\": \"string\"\r",
                  "        },\r",
                  "        \"orderById\": {\r",
                  "          \"type\": \"string\"\r",
                  "        },\r",
                  "        \"orderBy\": {\r",
                  "          \"type\": \"string\"\r",
                  "        },\r",
                  "        \"productOrderedId\": {\r",
                  "          \"type\": \"string\"\r",
                  "        },\r",
                  "        \"productName\": {\r",
                  "          \"type\": \"string\"\r",
                  "        },\r",
                  "        \"country\": {\r",
                  "          \"type\": \"string\"\r",
                  "        },\r",
                  "        \"productDescription\": {\r",
                  "          \"type\": \"string\"\r",
                  "        },\r",
                  "        \"productImage\": {\r",
                  "          \"type\": \"string\"\r",
                  "        },\r",
                  "        \"orderPrice\": {\r",
                  "          \"type\": \"string\"\r",
                  "        },\r",
                  "        \"__v\": {\r",
                  "          \"type\": \"number\"\r",
                  "        }\r",
                  "      },\r",
                  "      \"required\": [\r",
                  "        \"_id\",\r",
                  "        \"orderById\",\r",
                  "        \"orderBy\",\r",
                  "        \"productOrderedId\",\r",
                  "        \"productName\",\r",
                  "        \"country\",\r",
                  "        \"productDescription\",\r",
                  "        \"productImage\",\r",
                  "        \"orderPrice\",\r",
                  "        \"__v\"\r",
                  "      ]\r",
                  "    },\r",
                  "    \"message\": {\r",
                  "      \"type\": \"string\"\r",
                  "    }\r",
                  "  },\r",
                  "  \"required\": [\r",
                  "    \"data\",\r",
                  "    \"message\"\r",
                  "  ]\r",
                  "}\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "pm.test(\"View ordered product\",function()\r",
                  "{\r",
                  "    pm.expect(response.message).to.be.eql(\"Orders fetched for customer Successfully\")\r",
                  "});\r",
                  "//Validate product Name\r",
                  "pm.test(\"Validate product Name\",function()\r",
                  "{\r",
                  "    pm.expect(response.data.productName).to.eql(pm.collectionVariables.get(\"productName\"));\r",
                  "});\r",
                  "//Validate response schema\r",
                  "pm.test(\"Validate json response schema\", function() {\r",
                  "    pm.response.to.have.jsonSchema(schema);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
