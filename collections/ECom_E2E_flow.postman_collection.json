        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test(\"Validate login message\", function () ",
                  "{",
                  "    pm.expect(response.message).to.eql(\"Login Successfully\");  ",
                  "    });",
                  "    pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.expect(response.token).to.not.be.null;",
                  "pm.expect(response.userId).to.not.be.null;",
                  "pm.environment.set(\"token\", response.token);",
                  "pm.environment.set(\"userId\", response.userId);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
